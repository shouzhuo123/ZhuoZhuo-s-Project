# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML files - consistent line endings
*.asset linguist-language=YAML
*.yaml linguist-language=YAML
*.yml linguist-language=YAML

# Unity meta files
*.meta text=auto

# C# source files
*.cs text=auto eol=lf

# Shader files
*.shader text=auto eol=lf
*.cginc text=auto eol=lf
*.hlsl text=auto eol=lf

# Force LF for these files
*.json text eol=lf

